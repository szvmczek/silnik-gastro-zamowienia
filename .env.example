# --- Backend ---
SPRING_PROFILES_ACTIVE=dev

# JWT - WYGENERUJ wlasny secret przed Faza 1 (min 64 znaki, base64 OK).
# Przyklad generowania: openssl rand -base64 48
JWT_SECRET=replace-me-before-phase-1-min-64-chars-base64-recommended

# Admin seed (uzywane przez Faze 1 przy seedowaniu usera)
ADMIN_EMAIL=admin@pizza-demo.local
ADMIN_PASSWORD=change-me-on-first-run

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# DB (defaultuje do lokalnego docker-compose)
DB_URL=jdbc:postgresql://localhost:5432/pizza_showcase
DB_USERNAME=pizza
DB_PASSWORD=pizza

# --- Frontend ---
VITE_API_BASE_URL=/api
